DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/app_db
SESSION_SECRET=
# Opcional; quando ausente, os tokens de checkout derivam de SESSION_SECRET.
PAYMENT_TOKEN_SECRET=
# Segredo aleatório com pelo menos 32 caracteres, enviado pelo Vercel Cron.
CRON_SECRET=
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
PAYMENTS_GATEWAY=infinitepay
RESEND_API_KEY=

# InfiniteTag sem o caractere $, usada pelo seed/bootstrap local.
# Em uso normal, cada organização conecta a própria InfiniteTag pela interface.
INFINITEPAY_HANDLE=

# Endpoint oficial atual. Só altere se a InfinitePay fornecer um sandbox.
# INFINITEPAY_API_URL=https://api.checkout.infinitepay.io

APP_BASE_URL=http://localhost:3000

# Senha do usuário criado por `npm run db:seed` (só uso local/dev).
SEED_USER_PASSWORD=

# WhatsApp Cloud API (automações exclusivas do módulo CobraDora).
# Todas estas variáveis são segredos/configurações de servidor; nunca use NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional; permite atualizar a versão sem alterar código. O fallback atual é v25.0.
WHATSAPP_GRAPH_API_VERSION=v25.0
# Segredo arbitrário escolhido para o handshake GET /api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret da Meta, usado para validar X-Hub-Signature-256 no POST do webhook.
WHATSAPP_APP_SECRET=
# Nomes exatos dos dois templates aprovados na Meta, em pt_BR.
WHATSAPP_CHARGE_TEMPLATE_NAME=
WHATSAPP_ORGANIZER_UPDATE_TEMPLATE_NAME=
# Compatibilidade temporária: fallback legado somente para o template de cobrança.
WHATSAPP_TEMPLATE_NAME=
